{
  "// note": "Backend build for serverless (Vercel). Emits src/ -> dist/ as Node ESM. The main tsconfig.json is noEmit (tsx/vite run TS directly).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["src"]
}
