# ── GateKeep — CHAIN mode (real on-chain settlement) ──────────────────────
# Used by docker-compose and `npm run chain:deploy`. The keys below are the
# PUBLIC, well-known Anvil test accounts — safe to commit, NEVER use on mainnet.

X402_MODE=chain
X402_NETWORK=avalanche-fuji

# RPC + chain. For local Anvil the chain id must match `anvil --chain-id`.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=43113

# The EIP-3009 USDC token. Default = MockUSDC's deterministic first-deploy
# address on a fresh Anvil chain (deployed by FACILITATOR_PRIVATE_KEY at nonce 0).
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
USDC_NAME=USD Coin
USDC_VERSION=2
USDC_DECIMALS=6

# Facilitator: submits settlement txs + pays gas. Anvil account #0.
FACILITATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Demo agent: signs payments, must hold USDC. Anvil account #1.
AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Platform's USDC receiving address. Anvil account #2.
PLATFORM_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
PLATFORM_FEE_BPS=1000

PORT=4021
PUBLIC_BASE_URL=http://localhost:4021
