# ── GateKeep — Avalanche Fuji testnet (REAL on-chain settlement) ──────────
# Copy to `.env.fuji` and fill in funded keys, OR just run `npm run fuji:setup`
# to generate fresh wallets automatically.
#
#   ⚠️  NEVER commit `.env.fuji` — it holds real private keys (it is gitignored).

X402_MODE=chain
X402_NETWORK=avalanche-fuji
CHAIN_ID=43113
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# MockUSDC on Fuji — left blank; `npm run fuji:deploy` deploys it and fills this in.
USDC_ADDRESS=
USDC_NAME=USD Coin
USDC_VERSION=2
USDC_DECIMALS=6

# Facilitator — submits settlements + pays AVAX gas.
#   FUND THIS ADDRESS with Fuji AVAX: https://faucet.avax.network
FACILITATOR_PRIVATE_KEY=0x<facilitator key, funded with Fuji AVAX>

# Demo agent — receives MockUSDC from the deploy step (needs no AVAX; payments are gasless).
AGENT_PRIVATE_KEY=0x<agent key>

# Platform treasury: receives gross USDC and pays out each seller's share when
# they withdraw. Needs a little AVAX for payout gas.
PLATFORM_WALLET=0x<your treasury address>
PLATFORM_PRIVATE_KEY=0x<treasury key — signs payouts>
PLATFORM_FEE_BPS=1000

# ERC-8004 registries — filled in automatically by `npm run fuji:erc8004`.
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

PORT=4021
PUBLIC_BASE_URL=http://localhost:4021

# ── Optional: serverless persistence (Vercel / any stateless host) ──
# When BOTH are set, the store keeps its data in Upstash Redis instead of a local
# JSON file, so it survives across stateless serverless invocations. Create a free
# Redis database at https://upstash.com and copy its REST URL + token here.
# Leave blank for the local / long-running server (uses data/db.json).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
