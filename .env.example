# ── GateKeep configuration (MOCK mode) ────────────────────────────────────
# Everything has a working default — copy to `.env` only to change something.
# MOCK mode (the default) needs ZERO setup and runs fully offline.
#
# For REAL on-chain settlement (Anvil / Avalanche), use `.env.chain` instead and
# set X402_MODE=chain — see docs/DEPLOY.md.

# Port the gateway + API + dashboard run on.
PORT=4021

# Public origin where gated URLs live. Must be reachable by paying agents.
PUBLIC_BASE_URL=http://localhost:4021

# "mock"  → real EIP-712 signing + real signature verification, simulated
#           on-chain settlement. No wallet, no funds, no network. (default)
# "chain" → settle a real EIP-3009 USDC transfer via a GateKeep-run facilitator
#           against any EVM RPC (Anvil locally, Avalanche in prod). See .env.chain.
X402_MODE=mock

# Cosmetic network label shown in the dashboard (mock mode).
X402_NETWORK=base-sepolia

# The platform's USDC receiving address — every agent payment lands here.
PLATFORM_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Platform take rate, in basis points. 1000 = 10%.
PLATFORM_FEE_BPS=1000

# The demo agent's key (mock mode). Default = public Anvil test key #0.
AGENT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
